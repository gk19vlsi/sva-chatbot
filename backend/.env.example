# ============================================
# SVA-Chatbot Environment Configuration
# ============================================

# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=sva_chatbot

# ============================================
# LLM Provider Configuration
# ============================================
# Choose which LLM provider to use: "groq" or "openai"
# Defaults to "groq" if not specified (backward compatible)
LLM_PROVIDER=groq

# Groq API Configuration
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_PRIMARY_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
# Only required if LLM_PROVIDER is set to "openai"
OPENAI_API_KEY=your_openai_api_key_here
# Primary model for all LLM operations (recommended: gpt-4o for best quality)
OPENAI_PRIMARY_MODEL=gpt-4o
# Fallback model used when primary model fails or hits rate limits (gpt-4o-mini is faster and cheaper)
OPENAI_FALLBACK_MODEL=gpt-4o-mini

# JWT Configuration
JWT_SECRET_KEY=your_secret_key_here_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Application Configuration
ENVIRONMENT=development
DEBUG=true

# File Upload Configuration
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=./uploads

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=server.log

# Performance Configuration
# Number of Uvicorn workers (production)
WORKERS=4
# Background job queue workers
JOB_QUEUE_WORKERS=5

# Cache Configuration
PATTERN_CACHE_TTL=3600
LLM_CACHE_TTL=1800
QUERY_CACHE_TTL=300

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Groq Rate Limit Management (for free tier)
# Set ENABLE_RATE_LIMIT_DELAYS=true to add delays between API calls
# This helps avoid hitting Groq's 12,000 tokens/minute limit
ENABLE_RATE_LIMIT_DELAYS=true
AGENT_DELAY_SECONDS=2.0
API_CALL_DELAY_SECONDS=0.5
USE_AGGRESSIVE_FALLBACK=true
